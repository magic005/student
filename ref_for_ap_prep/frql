public SumorSameGame(int numRows, int numCols) {
    puzzle = new int[numRows][numCols];

    for (int r = 0; r <= numRows - 1; r++) {
        for (int c = 0; c <= numCols - 1; c++) {
            puzzle[r][c] = (int)((Math.random() * 9) + 1);
        }
    };
};


b.

public boolean clearPair(int row, int col) {
    for (int r = 0; r <= puzzle.length - 1; r++) {
        for (int c = 0; c <= puzzle[0].length - 1; c++) {
            if (r >= row && ((puzzle[row][col] + puzzle[r][c] == 10) || (puzzle[row][col] == puzzle[r][c])) {
                puzzle[r][c] = 0;
                puzzle[row][col] = 0;
                return true;
            };
        };
    };
    return false;
};
                

public boolean clearPair(int col1, int col2) {
    for (int r1 = 0; r1 <= puzzle.length - 1; r1++) {
        for (int r2 = r1 + 1; r2 <= puzzle.length - 1; r2++) {
            if (puzzle[r1][col1] == puzzle[r2][col2]) {
                puzzle[r1][col1] = 0;
                puzzle[r2][col2] = 0;
            }
            if (puzzle[r1][col1] + puzzle[r2][col2] == 10) {
                puzzle[r1][col1] = 0;
                puzzle[r2][col2] = 0;
            }
        }
    };
};










    
