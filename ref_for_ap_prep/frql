public ArrayList<Match> buildMatches() {
    if (competitorList.size() % 2 == 0) {
        for (int i = 0; i < competitorList.size / 2; i++) {
            new Match(competitorList.get(i), competitorList.get(competitorList.size()- i));
        }
    }
    else {
        ArrayList<String> list = ArrayList<competitors>;
        list.remove(0);
        for (int i = 0; i < list.size / 2; i++) {
            Match(list.get(i), list.get(list.size()- i));
        }
    }
    return ArrayList<Match>;
};


