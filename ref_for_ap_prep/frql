public class SignedText {
    // fields
    private String firstName;
    private String lastName;

    // constructor
    public SignedText(String f, String l) {
        firstName = f;
        lastName = l;
    };

    // methods
    public String getSignature() {
        if (firstName.length() == 0) {
            return lastName;
        }
        else {
            return firstName.charAt(0) + "-" + lastName;
        };
    };

    public String addSignature(String text) {
        if (text.indexOf(getSignature()) == -1) {
            return text + getSignature();
        };
        if (text.endsWith(getSignature())) {
            return text;
        };
        if (text.startsWith(getSignature()) {
            return text.substring(getSignature().length()) + getSignature();
        };
    };
};


