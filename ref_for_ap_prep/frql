public int dogWalkShift(int startHour, int endHour) {
    int pay = 0;
    for (int hr = startHour; hr <= endHour; hr++) {
        int dogs_for_the_hour = walkDogs(hr)
        pay += (5 * dogs_for_the_hour);
        if (dogs_for_the_hour == maxDogs || (hr >= 9 && hr <= 17)) {
            pay += 3;
        };
    };
    return pay;
};



