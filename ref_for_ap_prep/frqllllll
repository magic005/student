public boolean isWordChain() {
    int count = 0;
    for (int i = 1; i <= wordList.size() - 1; i++) {
        if (wordList.get(i).containts(wordList.get(i-1)) {
            count++;
        };
    };

    return count == (wordList.size() - 1);
};
       

public ArrayList<String> createList(String target) {
    ArrayList<String> list = new ArrayList<>();
    
    for (int i = 0; i <= wordList.size() - 1; i++) {
        if (wordList.get(i).startsWith(target)) {
            list.add(wordList.get(i).substring(target.length() - 1, wordList.get(i).length() - 1);
        };
    };
};
    

